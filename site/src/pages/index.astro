---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Garden Updates">
  <section class="post-list">
    <h1 class="page-title">Garden Updates</h1>
    <p class="page-subtitle">
      Daily insights from soil moisture, temperature, and humidity sensors —
      compared across Claude and GPT models each morning.
    </p>

    {posts.length === 0 ? (
      <p class="no-posts">No posts yet. The pipeline runs daily at 8 am NZST.</p>
    ) : (
      <ul class="posts">
        {posts.map(post => (
          <li class="post-item">
            <a href={`${base}/posts/${post.slug}`} class="post-link">
              <time class="post-item-date">{post.data.date}</time>
              <h2 class="post-item-title">{post.data.title}</h2>
              <p class="post-item-desc">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
