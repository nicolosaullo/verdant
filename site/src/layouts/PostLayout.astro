---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  date: string;
}

const { title, description, date } = Astro.props;

const formattedDate = new Date(date + 'T00:00:00').toLocaleDateString('en-NZ', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <article class="post">
    <header class="post-header">
      <time class="post-date" datetime={date}>{formattedDate}</time>
      <h1 class="post-title">{title}</h1>
    </header>
    <div class="post-content">
      <slot />
    </div>
  </article>
</Base>
